//@version=6
indicator("OHLCV Estimated CVD / Delta Pressure Analyzer", "OHLCV CVD Delta", overlay = false)

//------------------------------------------------------------------------------
// DATA HONESTY
//------------------------------------------------------------------------------
// This indicator estimates buy volume, sell volume, delta, and CVD from OHLCV.
// Pine does not provide historical DOM, true bid/ask aggressor flow, or exact
// footprint tape reconstruction.

//------------------------------------------------------------------------------
// INPUTS
//------------------------------------------------------------------------------
groupData = "Data"
groupDelta = "Delta"
groupDisplay = "Display"
groupAlerts = "Alerts"

volumeMaLength = input.int(20, "Volume MA Length", minval = 1, group = groupData)
deltaMethod = input.string("Composite", "Delta Estimation Method", options = ["Candle Direction", "CLV", "Body/Range", "Wick Pressure", "Composite"], group = groupData)

deltaAverageLength = input.int(20, "Average Delta Length", minval = 1, group = groupDelta)
cvdResetMode = input.string("Daily", "CVD Reset Mode", options = ["Never", "Daily", "Weekly", "Session", "Custom"], group = groupDelta)
customResetSession = input.session("0930-1600", "Custom Reset Session", group = groupDelta)
cvdAverageLength = input.int(34, "CVD Average Length", minval = 1, group = groupDelta)

showPerBarPressure = input.bool(true, "Show Estimated Per-Bar Delta Pressure", group = groupDisplay)
showDelta = input.bool(true, "Show Estimated Delta Per Bar", group = groupDisplay)
showDeltaAverage = input.bool(true, "Show Average Delta", group = groupDisplay)
showCvd = input.bool(true, "Show Estimated Cumulative Volume Delta (CVD)", group = groupDisplay)
showCvdAverage = input.bool(true, "Show CVD Average", group = groupDisplay)
showZeroLine = input.bool(true, "Show Zero Line", group = groupDisplay)
pressureAsColumns = input.bool(true, "Pressure Style: Columns (off = Histogram)", group = groupDisplay)
deltaAsColumns = input.bool(true, "Delta Style: Columns (off = Histogram)", group = groupDisplay)
normalizeForPane = input.bool(false, "Normalize Delta/CVD For Readability", group = groupDisplay)
normalizationLength = input.int(100, "Normalization Length", minval = 10, group = groupDisplay)

alertsBarCloseOnly = input.bool(true, "Require Bar-Close Confirmation", group = groupAlerts)

//------------------------------------------------------------------------------
// HELPERS
//------------------------------------------------------------------------------
f_safeDiv(float numerator, float denominator) =>
    na(denominator) or denominator == 0.0 ? 0.0 : numerator / denominator

f_clamp(float value, float low, float high) =>
    math.max(low, math.min(high, value))

f_sessionValid(string sessionText) =>
    str.length(sessionText) >= 9 and str.contains(sessionText, "-")

f_zNormalize(float src, int length) =>
    stdev = ta.stdev(src, length)
    stdev == 0.0 or na(stdev) ? 0.0 : (src - ta.sma(src, length)) / stdev

//------------------------------------------------------------------------------
// OHLCV-DERIVED DELTA ESTIMATION
//------------------------------------------------------------------------------
barRange = math.max(high - low, syminfo.mintick)
bodyRange = close - open
upperWick = math.max(high - math.max(open, close), 0.0)
lowerWick = math.max(math.min(open, close) - low, 0.0)
clv = f_safeDiv((close - low) - (high - close), barRange)
volumeMa = ta.sma(volume, volumeMaLength)
volumeParticipation = f_clamp(f_safeDiv(volume, volumeMa), 0.0, 1.0)

candleDirectionPressure = close > open ? 1.0 : close < open ? -1.0 : 0.0
clvPressure = clv
bodyPressure = f_safeDiv(bodyRange, barRange)
wickPressure = f_safeDiv(lowerWick - upperWick, barRange)

rawPressure = deltaMethod == "Candle Direction" ? candleDirectionPressure :
     deltaMethod == "CLV" ? clvPressure :
     deltaMethod == "Body/Range" ? bodyPressure :
     deltaMethod == "Wick Pressure" ? wickPressure :
     (candleDirectionPressure + clvPressure + bodyPressure + wickPressure) / 4.0

estimatedPressure = f_clamp(rawPressure * volumeParticipation, -1.0, 1.0)
estimatedPressurePct = estimatedPressure * 100.0

estimatedBuyVolume = volume * (1.0 + estimatedPressure) * 0.5
estimatedSellVolume = volume * (1.0 - estimatedPressure) * 0.5
estimatedDelta = estimatedBuyVolume - estimatedSellVolume
averageDelta = ta.sma(estimatedDelta, deltaAverageLength)

//------------------------------------------------------------------------------
// CVD WITH RESET MODES
//------------------------------------------------------------------------------
newDay = ta.change(time("D")) != 0
newWeek = ta.change(time("W")) != 0
sessionBar = time(timeframe.period, syminfo.session)
newSession = not na(sessionBar) and na(sessionBar[1])
customSessionBar = f_sessionValid(customResetSession) ? time(timeframe.period, customResetSession) : na
newCustomReset = not na(customSessionBar) and na(customSessionBar[1])

resetCvd = cvdResetMode == "Daily" ? newDay :
     cvdResetMode == "Weekly" ? newWeek :
     cvdResetMode == "Session" ? newSession :
     cvdResetMode == "Custom" ? newCustomReset : false

var float cumulativeDelta = 0.0
cumulativeDelta := resetCvd ? estimatedDelta : nz(cumulativeDelta[1]) + estimatedDelta
cvdAverage = ta.sma(cumulativeDelta, cvdAverageLength)

// Optional normalization for readability in one pane.
displayDelta = normalizeForPane ? f_zNormalize(estimatedDelta, normalizationLength) * 25.0 : estimatedDelta
displayAvgDelta = normalizeForPane ? f_zNormalize(averageDelta, normalizationLength) * 25.0 : averageDelta
displayCvd = normalizeForPane ? f_zNormalize(cumulativeDelta, normalizationLength) * 50.0 : cumulativeDelta
displayCvdAverage = normalizeForPane ? f_zNormalize(cvdAverage, normalizationLength) * 50.0 : cvdAverage

//------------------------------------------------------------------------------
// PLOTS
//------------------------------------------------------------------------------
zeroColor = color.new(color.gray, 70)
if showZeroLine
    hline(0.0, "Zero", color = zeroColor, linestyle = hline.style_dotted)

pressureColor = estimatedPressurePct >= 0 ? color.new(color.lime, 0) : color.new(color.red, 0)
deltaColor = displayDelta >= 0 ? color.new(color.teal, 0) : color.new(color.orange, 0)

plot(showPerBarPressure ? estimatedPressurePct : na, "Estimated Per-Bar Delta Pressure (OHLCV %)", style = pressureAsColumns ? plot.style_columns : plot.style_histogram, color = pressureColor, linewidth = 2)
plot(showDelta ? displayDelta : na, "Estimated Delta Per Bar (OHLCV)", style = deltaAsColumns ? plot.style_columns : plot.style_histogram, color = deltaColor, linewidth = 1)
plot(showDeltaAverage ? displayAvgDelta : na, "Estimated Average Delta (OHLCV)", color = color.new(color.blue, 0), linewidth = 2)
plot(showCvd ? displayCvd : na, "Estimated Cumulative Volume Delta CVD (OHLCV)", color = color.new(color.yellow, 0), linewidth = 2)
plot(showCvdAverage ? displayCvdAverage : na, "Estimated CVD Average (OHLCV)", color = color.new(color.purple, 0), linewidth = 2)

//------------------------------------------------------------------------------
// ALERTS
//------------------------------------------------------------------------------
alertGate = alertsBarCloseOnly ? barstate.isconfirmed : true
positivePressure = estimatedPressurePct > 0
negativePressure = estimatedPressurePct < 0
deltaCrossUp = ta.crossover(estimatedDelta, averageDelta)
deltaCrossDown = ta.crossunder(estimatedDelta, averageDelta)
cvdCrossUp = ta.crossover(cumulativeDelta, cvdAverage)
cvdCrossDown = ta.crossunder(cumulativeDelta, cvdAverage)
cvdZeroCrossUp = ta.crossover(cumulativeDelta, 0.0)
cvdZeroCrossDown = ta.crossunder(cumulativeDelta, 0.0)

alertcondition(alertGate and positivePressure, "Estimated Positive Delta Pressure", "Estimated OHLCV delta pressure is positive.")
alertcondition(alertGate and negativePressure, "Estimated Negative Delta Pressure", "Estimated OHLCV delta pressure is negative.")
alertcondition(alertGate and deltaCrossUp, "Estimated Delta Crossed Above Average", "Estimated OHLCV delta crossed above its average.")
alertcondition(alertGate and deltaCrossDown, "Estimated Delta Crossed Below Average", "Estimated OHLCV delta crossed below its average.")
alertcondition(alertGate and cvdCrossUp, "Estimated CVD Crossed Above Average", "Estimated OHLCV CVD crossed above its average.")
alertcondition(alertGate and cvdCrossDown, "Estimated CVD Crossed Below Average", "Estimated OHLCV CVD crossed below its average.")
alertcondition(alertGate and cvdZeroCrossUp, "Estimated CVD Crossed Above Zero", "Estimated OHLCV CVD crossed above the zero line.")
alertcondition(alertGate and cvdZeroCrossDown, "Estimated CVD Crossed Below Zero", "Estimated OHLCV CVD crossed below the zero line.")

//------------------------------------------------------------------------------
// NOTES
//------------------------------------------------------------------------------
// Current open-bar values can change until bar close.
// Pine cannot open multiple independent panes from one script. Duplicate this
// script or split it into multiple scripts if you need separate panels.
